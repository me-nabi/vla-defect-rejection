<mujoco model="conveyor_belt_arena">
  <asset>
    <texture builtin="gradient" height="256" rgb1=".9 .9 1." rgb2=".2 .3 .4" type="skybox" width="256"/>

    <!-- floor -->
    <texture file="../textures/tile_grigia_caldera_porcelain_floor.png" type="2d" name="texplane"/>
    <material name="floorplane" reflectance="0.0" shininess="0.0"
              specular="0.0" texrepeat="3 3" texture="texplane" texuniform="true"/>

    <!-- belt surface -->
    <texture builtin="flat" height="512" width="512" rgb1="0.18 0.18 0.2" rgb2="0.15 0.15 0.17" name="tex-belt"/>
    <material name="belt_mat" texture="tex-belt" specular="0.05" shininess="0.1" reflectance="0.0"/>

    <!-- belt legs/frame -->
    <texture builtin="flat" height="64" width="64" rgb1="0.5 0.5 0.52" rgb2="0.5 0.5 0.52" name="tex-frame"/>
    <material name="frame_mat" texture="tex-frame" specular="0.6" shininess="0.6" reflectance="0.3"/>

    <!-- wall -->
    <texture file="../textures/smooth_light_gray_plaster.png" type="2d" name="tex-wall"/>
    <material name="walls_mat" reflectance="0.0" shininess="0.3" specular="0.8" texrepeat="3 3" texture="tex-wall" texuniform="true"/>
  </asset>

  <worldbody>
    <!-- Floor -->
    <geom condim="3" group="1" material="floorplane" name="floor" pos="0 0 0" size="3 3 .125" type="plane"/>

    <!-- Walls -->
    <geom pos="0.5 3 1.5" quat="0.7071 0.7071 0 0" size="2.5 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_left_visual" material="walls_mat"/>
    <geom pos="0.5 -3 1.5" quat="0.7071 -0.7071 0 0" size="2.5 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_right_visual" material="walls_mat"/>
    <geom pos="-2 0 1.5" quat="0.5 0.5 0.5 0.5" size="3 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_rear_visual" material="walls_mat"/>
    <geom pos="3 0 1.5" quat="0.5 0.5 -0.5 -0.5" size="3 1.5 0.01" type="box" conaffinity="0" contype="0" group="1" name="wall_front_visual" material="walls_mat"/>

    <!-- Conveyor Belt Body (replaces table) -->
    <body name="table" pos="0 0 0.4">
      <!-- Belt surface - collision -->
      <geom pos="0 0 0" size="0.5 0.2 0.025" type="box" group="0" name="table_collision" friction="0.6 0.005 0.0001"/>
      <!-- Belt surface - visual -->
      <geom pos="0 0 0" size="0.5 0.2 0.025" type="box" conaffinity="0" contype="0" group="1" name="table_visual" material="belt_mat"/>
      <!-- Belt top site -->
      <site pos="0 0 0.025" name="table_top" size="0.001 0.001 0.001" rgba="0 0 0 0"/>

      <!-- Side rails -->
      <geom pos="0 -0.21 0.04" size="0.5 0.01 0.015" type="box" conaffinity="0" contype="0" group="1" name="rail_left" material="frame_mat"/>
      <geom pos="0 0.21 0.04" size="0.5 0.01 0.015" type="box" conaffinity="0" contype="0" group="1" name="rail_right" material="frame_mat"/>

      <!-- Legs -->
      <geom pos="0.4 -0.18 -0.2" size="0.02 0.2" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg1_visual" material="frame_mat"/>
      <geom pos="0.4 0.18 -0.2" size="0.02 0.2" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg2_visual" material="frame_mat"/>
      <geom pos="-0.4 -0.18 -0.2" size="0.02 0.2" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg3_visual" material="frame_mat"/>
      <geom pos="-0.4 0.18 -0.2" size="0.02 0.2" type="cylinder" conaffinity="0" contype="0" group="1" name="table_leg4_visual" material="frame_mat"/>
    </body>

    <!-- Lighting -->
    <light name="light1" diffuse=".8 .8 .8" dir="0 -.15 -1" directional="false" pos="1 1 4.0" specular="0.3 0.3 0.3" castshadow="false"/>
    <light name="light2" diffuse=".8 .8 .8" dir="0 -.15 -1" directional="false" pos="-3. -3. 4.0" specular="0.3 0.3 0.3" castshadow="false"/>

    <!-- Cameras -->
    <camera mode="fixed" name="frontview" pos="1.0 0 1.45" quat="0.56 0.43 0.43 0.56"/>
    <camera mode="fixed" name="birdview" pos="-0.2 0 3.0" quat="0.7071 0 0 0.7071"/>
    <camera mode="fixed" name="agentview" pos="0.5 0 1.35" quat="0.653 0.271 0.271 0.653"/>
    <camera mode="fixed" name="sideview" pos="-0.057 1.276 1.488" quat="0.010 0.007 0.591 0.806"/>
  </worldbody>
</mujoco>
