(define (problem Conveyor_Belt_Manipulation)
  (:domain robosuite)
  (:language Inspect bottles on conveyor belt and reject defective ones)
    (:regions
      (bottle_spawn_1
          (:target conveyor_belt)
          (:ranges (
              (0.825 -0.03 0.855 0.03)
            )
          )
      )
      (bottle_spawn_2
          (:target conveyor_belt)
          (:ranges (
              (0.695 -0.03 0.725 0.03)
            )
          )
      )
      (bottle_spawn_3
          (:target conveyor_belt)
          (:ranges (
              (0.565 -0.03 0.595 0.03)
            )
          )
      )
      (bottle_spawn_4
          (:target conveyor_belt)
          (:ranges (
              (0.435 -0.03 0.465 0.03)
            )
          )
      )
      (bottle_spawn_5
          (:target conveyor_belt)
          (:ranges (
              (0.305 -0.03 0.335 0.03)
            )
          )
      )
      (bin_region
          (:target conveyor_belt)
          (:ranges (
              (-0.21 0.048 -0.03 0.218)
            )
          )
      )
      (contain_region
          (:target reject_bin_1)
      )
    )

  (:fixtures
    conveyor_belt - table
  )

  (:objects
    bottle_1 bottle_2 bottle_3 bottle_4 bottle_5 - inspection_bottle
    reject_bin_1 - reject_bin
  )

  (:obj_of_interest
    bottle_1
    bottle_2
    bottle_3
    bottle_4
    bottle_5
    reject_bin_1
  )

  (:init
    (On bottle_1 conveyor_belt_bottle_spawn_1)
    (On bottle_2 conveyor_belt_bottle_spawn_2)
    (On bottle_3 conveyor_belt_bottle_spawn_3)
    (On bottle_4 conveyor_belt_bottle_spawn_4)
    (On bottle_5 conveyor_belt_bottle_spawn_5)
    (On reject_bin_1 conveyor_belt_bin_region)
  )

  (:goal
    (And)
  )

)
